# SMTP & IMAP Credentials (Google Workspace / Gmail App Password)

GMAIL_USER=your.institutional.email@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional Corporate HTTP Proxy Tunneling (PySocks)
